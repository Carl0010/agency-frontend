# Where the Next server proxies /api/v1 (server-side only).
API_INTERNAL_URL=http://127.0.0.1:4100
# Realtime socket origin as seen by the browser.
NEXT_PUBLIC_WS_URL=http://localhost:4100
# Paddle checkout on /pay (the default payment link in Paddle > Checkout settings).
# Client-side token from Paddle > Developer tools > Authentication; public by design.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# sandbox (test_ tokens) or production (live_ tokens).
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
